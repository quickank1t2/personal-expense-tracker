{
  "name": "personal-expense-tracker",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/postgres": "^2.3.3",
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^2.4.3",
    "jest": "^30.5.2"
  },
  "scripts": {
    "start": "cds-serve",
    "start:local": "cp db/data/prod/my.expensetracker-Expenses.csv db/data/my.expensetracker-Expenses.csv && cds watch --port 4005",
    "test": "jest --testTimeout=30000"
  },
  "private": true,
  "cds": {
    "model": [
      "db",
      "srv"
    ],
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "user": {
            "roles": [
              "User"
            ]
          }
        }
      }
    },
    "[development]": {
      "requires": {
        "auth": "dummy"
      }
    },
    "[postgres]": {
      "requires": {
        "db": {
          "kind": "postgres",
          "impl": "@cap-js/postgres"
        }
      }
    }
  }
}
